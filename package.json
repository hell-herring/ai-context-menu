{
  "name": "ai-context-menu",
  "version": "0.0.0",
  "private": true,
  "description": "右クリックで選択テキストやページ本文を AI に要約させる Chrome 拡張機能",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:build": "vitest run --config vitest.build.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@mozilla/readability": "0.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
  }
}
